{
  "expo": {
    "name": "DermaSeva",
    "slug": "dermaseva",
    "version": "1.0.0",
    "scheme": "dermaseva",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vivekjami.dermaseva"
    },
    "android": {
      "package": "com.vivekjami.dermaseva",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "CAMERA",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "allowBackup": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-camera",
      "expo-sqlite",
      "expo-secure-store",
      "expo-asset",
      "react-native-litert-lm",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "assetBundlePatterns": [
      "docs/**/*",
      "assets/**/*"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f7cdb65b-4437-4cff-b90e-fb7a39bdfb1a"
      }
    }
  }
}
